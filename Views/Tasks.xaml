<Page x:Class="ProjectManager.Views.Tasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.modernwpf.com/2019" 
      xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      DataContext="{Binding TasksViewMoodel, Source={StaticResource Locator}}" 
      mc:Ignorable="d" 
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="Tasks">

    <Page.Resources>

        <!-- Subtle/minimalist TaskTemplate -->
        <DataTemplate x:Key="TaskTemplate">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="CheckboxMultipleBlank" Foreground="Black" Width="22" Height="22" Grid.RowSpan="4" VerticalAlignment="Center"/>
                <StackPanel Grid.RowSpan="4" Grid.Column="1" Margin="8, 8, 16, 8" Orientation="Horizontal" >
                    <TextBlock Text="{Binding IdTask}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="Black" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IdTaskNavigation.Name}" Margin="6,0,0,0" Foreground="Black" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <materialDesign:PackIcon Grid.Column="2" Margin="12,0,0,0" Grid.RowSpan="4" Kind="CalendarClock" Width="20" Height="20" Foreground="Black" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Margin="8,0,0,0"
                           FontSize="12">
                    <Run Text="Start:" Foreground="Black"/>
                    <Run Text="{Binding LongStartDate, Mode=OneWay}" FontWeight="Bold" Foreground="Black" />
                </TextBlock>
                <TextBlock Grid.Column="3"
                           Grid.Row="1"
                           Margin="8,0,0,0"
                           FontSize="12">
                    <Run Text="Target:" Foreground="Black"/>
                    <Run Text="{Binding LongEndDate, Mode=OneWay}" Foreground="Black" FontWeight="Bold" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="4" Grid.RowSpan="4" Margin="20,0,0,0">
                    <materialDesign:PackIcon Kind="TimerSand" Height="18" Width="18" VerticalAlignment="Center" Foreground="Black"/>
                    <TextBlock Margin="6,0,0,0" Foreground="Black" FontSize="12"  HorizontalAlignment="Center" VerticalAlignment="Center" >
                        <Run Text="{Binding Duration}" FontWeight="Bold" Foreground="Green"/>
                        <Run Text="d" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="5" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Center" Margin="16,0,0,0" >
                    <Border CornerRadius="8"
                            Background="{Binding IdStatusNavigation.StatusColor}"
                            Height="24"
                            Width="95">
                        <TextBlock Foreground="White" Text="{Binding IdStatusNavigation.Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- ProjectTemplate aligned with History DayTemplate design/info -->
        <HierarchicalDataTemplate x:Key="ProjectTemplate" ItemsSource="{Binding Path=Items}" ItemTemplate="{StaticResource TaskTemplate}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <!-- Icon -->
                <materialDesign:PackIcon Kind="FileDocument" Foreground="Green" Width="42" Height="42" Grid.RowSpan="4" VerticalAlignment="Center"/>
                <!-- ID Column -->
                <StackPanel Grid.RowSpan="4" Grid.Column="1" Margin="10, 12, 20, 12"  VerticalAlignment="Center">
                    <TextBlock Text="ID" HorizontalAlignment="Center" FontWeight="Bold" Foreground="Black" FontSize="17"/>
                    <TextBlock Text="{Binding Name.DisplayProjectId}" FontWeight="Black" Foreground="Green" FontSize="17" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- Quote Number Column -->
                <StackPanel Grid.Column="2" Grid.RowSpan="4" VerticalAlignment="Center">
                    <TextBlock Text="Quote #" FontSize="11" FontFamily="Quicksand Medium" Foreground="Black"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="Black"/>
                        <TextBlock Text="{Binding Name.QuoteNumber}" Margin="6,0,0,0" FontSize="14" Foreground="Black"/>
                    </StackPanel>
                </StackPanel>
                <!-- Manager Column -->
                <StackPanel  Grid.RowSpan="4" Grid.Column="3" VerticalAlignment="Center" >
                    <TextBlock Text="Project manager:" FontSize="11" FontFamily="Quicksand Medium" Foreground="Black" Margin="40, 0, 0, 0"/>
                    <StackPanel Orientation="Horizontal" Margin="0, 5, 0, 0">
                        <materialDesign:PackIcon Kind="AccountTie" Width="44" Height="44" Foreground="Black"/>
                        <StackPanel Margin="5, 0, 0, 0"  VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name.IdManagerNavigation.Name, Mode=OneWay}" HorizontalAlignment="Left" FontWeight="Bold" Foreground="Black" FontSize="14"/>
                            <TextBlock Text="{Binding Name.IdManagerNavigation.IdDepartamentNavigation.Name}" HorizontalAlignment="Left" FontWeight="DemiBold" Foreground="Green" FontSize="14" VerticalAlignment="Center" FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <!-- Customer + Parts Column -->
                <StackPanel Grid.Column="4" Grid.RowSpan="4" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Customer &amp; Parts" FontSize="11" FontFamily="Quicksand Medium" Foreground="Black"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                        <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="Black"/>
                        <TextBlock Text="{Binding Name.IdCustomerNavigation.Name}" Margin="6,0,0,0" FontSize="14" Foreground="Black"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Name.ProjectParts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <materialDesign:PackIcon Kind="PowerPlug" Width="18" Height="18" Foreground="Green"/>
                                    <TextBlock Text="{Binding Part.PartNumber}" Margin="6,0,0,0" FontSize="12" Foreground="Black"/>
                                    <TextBlock Text="{Binding Part.Revision}" Margin="6,0,0,0" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- Status Column -->
                <StackPanel Grid.Column="5" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Center" Margin="40, 0, 0, 0" >
                    <Border 
                        CornerRadius="10"
                        Background="{Binding Name.IdStatusNavigation.StatusColor}"
                        Grid.Column="4"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Height="30"
                        Width="95">
                        <TextBlock Foreground="White" Text="{Binding Name.IdStatusNavigation.Name}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" FontSize="15"/>
                    </Border>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <Style TargetType="{x:Type TreeViewItem}" x:Key="ContainerStyle">
            <Setter Property="ItemTemplate" Value="{StaticResource TaskTemplate}" />
            <Setter Property="IsExpanded" Value="True" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFCFCFCF" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFCFCFCF" />
            </Style.Resources>
        </Style>

    </Page.Resources>

    <Grid Background="#FFE0E0E0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="6*" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="100, 0, 0, 0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        Margin="0, 0, 0, 5">
                <Label Content="Filter" 
                       FontFamily="Quicksand Medium" 
                       FontSize="16" />
                <materialDesign:PackIcon 
                       Kind="Filter"
                       Width="22" 
                       Height="22"
                       Margin="2, 0, 0, 0"/>
            </StackPanel>
            <ComboBox 
                     Background="Green"
                     Foreground="White"
                     BorderThickness="0"
                     FontFamily="Quicksand Medium" 
                     FontSize="15"
                     Padding="10,4"
                     ItemsSource="{Binding FilterOptions}"
                     SelectedItem="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="450">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontFamily" Value="Quicksand Medium"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="6,2"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </StackPanel>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="350, 0, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="10, 0">
                <TextBlock Text="{Binding TaskCount}" FontSize="38" Foreground="Green" FontWeight="Black" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding HeaderText}" FontStyle="Italic"/>
            </StackPanel>

        </Grid>
        <TreeView x:Name="tvHistory" 
                  ItemsSource="{Binding Path=CvsChecklist.View.Groups}"
                  ItemContainerStyle="{StaticResource ContainerStyle}" 
                  ItemTemplate="{StaticResource ProjectTemplate}" 
                  Margin="100, 10 , 40, 40"
                  Grid.Row="1">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDoubleClick" >
                    <i:InvokeCommandAction Command="{Binding ElementName=tvHistory, Path=DataContext.NavigateToProjectCommand}" CommandParameter="{Binding ElementName=tvHistory, Path=SelectedItem.IdProjectNavigation}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TreeView>
    </Grid>
</Page>
